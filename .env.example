# ==========================================
# FeeTrack Deployment & Environment Config
# ==========================================

# Botchain Testnet RPC
BOTCHAIN_RPC_URL=https://rpc.bohr.life
BOTCHAIN_CHAIN_ID=968

# Private key for deployment script (Hardhat only - DO NOT share or expose to frontend)
# Format: 0x followed by 64 hex characters
PRIVATE_KEY=your_private_key_here

# Frontend Deployed FeeTrack Contract Address
# Read by Next.js application
NEXT_PUBLIC_FEETRACK_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOTCHAIN_CHAIN_ID=968
NEXT_PUBLIC_BOTCHAIN_EXPLORER_URL=https://scan.bohr.life

